# Data & models (thường quá lớn hoặc nhạy cảm cho git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*.pkl

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/

